# CFR autoresearch defaults. Copy to .env for local overrides; do not commit .env.
# Secret values should live in 1Password. If a value is an op:// reference, the
# runner should resolve it in memory and inject the resolved value only into the
# child process environment.

CFR_AUTORESEARCH_MAX_ITERATIONS=10
CFR_AUTORESEARCH_MAX_TOTAL_LLM_USD=25
CFR_AUTORESEARCH_MAX_ITERATION_LLM_USD=2

CFR_AUTORESEARCH_WORKER_MODEL=sonnet
CFR_AUTORESEARCH_WORKER_EFFORT=high

CFR_AUTORESEARCH_EXPLORATION_MODE=backlog-guided

# MLflow tracking. With nothing set, the runner logs to a durable local file
# store under autoresearch/mlruns.
#
# To log to a shared tracking server instead, set the URI here (a real server
# URL — file: URIs are ignored for delivery) plus any basic-auth credentials as
# op:// references. Resolve them only at the process boundary with `op run`.
#
# MLFLOW_TRACKING_URI=https://mlflow.<tailnet-name>.ts.net
# MLFLOW_TRACKING_USERNAME=op://<vault>/<item>/username
# MLFLOW_TRACKING_PASSWORD=op://<vault>/<item>/password
#
# Local fallback knobs (used only when no server URI is set):
CFR_AUTORESEARCH_MLFLOW_TRACKING_URI=file:./autoresearch/mlruns
CFR_AUTORESEARCH_MLFLOW_ARTIFACT_ROOT=file:./autoresearch/mlartifacts
CFR_AUTORESEARCH_MLFLOW_UI_PORT=5000

# Example secret reference, resolved at runtime and never written back to disk:
# ANTHROPIC_API_KEY=op://<vault>/<item>/ANTHROPIC_API_KEY
